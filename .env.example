# DigiWTAL Frontend – Beispielkonfiguration

# Basis-URL der CMS-API (ohne trailing slash)
CMS_API_URL=https://cms.example.com/api.php/api/v1

# Wird beim Rollout automatisch und kundenspezifisch aus der Verwaltung gesetzt.
CMS_API_TOKEN=your_managed_cms_api_token_here

# HTTP-Timeout in Sekunden
CMS_TIMEOUT=5

# Cache-TTL in Sekunden (empfohlen Produktion: 300 = 5 Minuten)
CMS_CACHE_TTL=300

# Öffentliche Basis-URL des Frontends (für robots.txt Sitemap-Zeile)
FRONTEND_BASE_URL=https://www.example.com

# Optional expliziter CMS-Sitemap-Endpunkt (falls Ableitung aus CMS_API_URL nicht passt)
CMS_SITEMAP_URL=https://cms.example.com/sitemap.xml
