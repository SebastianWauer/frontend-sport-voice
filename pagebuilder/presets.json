      {
        "type": "sport_voice_text",
        "data": {
          "layout": "portrait",
          "anchor": "sebastian",
          "topline": "ÜBER MICH",
          "section_number": "04",
          "title": "Ich bin Sebastian.",
          "title_accent": "Und ich erkläre\nMotorsport.",
          "text": "Hinter Sport Voice stehe ich, Sebastian Wauer. Mein Schwerpunkt liegt im GT- und Kartsport. Ich begleite Rennen als Kommentator und Events als Moderator – im Stream, vor der Kamera und direkt an der Strecke.\n\nGute Vorbereitung gehört für mich zum Einsatz: Fahrer und Teams, Regeln, Strategie und Meisterschaftsstände. Im Kommentar zählt dann, das Wichtige im richtigen Moment verständlich zu erklären.",
          "image_url": "/assets/sport-voice/sebastian-gtwc-portrait.jpg",
          "image_alt": "Sebastian Wauer lächelt vor einem GT World Challenge Europe-Hintergrund",
          "image_position": "left",
          "image_caption": "SEBASTIAN WAUER",
          "image_credit": "DER MENSCH AM MIKROFON",
          "point_count": "3",
          "button_text": "Einblicke auf Instagram",
          "button_url": "https://www.instagram.com/sebastianwauer/",
          "point_1_title": "Vorbereitet bis ins Detail.",
          "point_1_text": "Fakten und Zusammenhänge vor dem ersten Wort.",
          "point_2_title": "Nah an den Menschen.",
          "point_2_text": "Fahrer, Teams und ihre Geschichten im Mittelpunkt.",
          "point_3_title": "Klar in der Sprache.",
          "point_3_text": "Nachvollziehbar für neue Zuschauer und langjährige Fans."
        }
